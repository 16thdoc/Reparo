#!/usr/bin/env sh
# Reparo Linux: native, shell-agnostic maintenance runner.
# This is intentionally separate from the Windows PowerShell runtime.

set -u
umask 077

# Native and Windows runners share one Reparo release number and version flavor.
REPARO_LINUX_VERSION='1.4.2.0'
REPARO_VERSION_QUOTE='Fear is the mind-killer.'
REPARO_VERSION_SOURCE='Dune (1965), by Frank Herbert'
REPARO_VERSION_ART='  [ GOM JABBAR ] ---{ BOX }--- bounded reporting, no hidden commands'
REPARO_INSTALLER_URL="${REPARO_INSTALLER_URL:-}"
REPARO_RELEASE_URL="${REPARO_RELEASE_URL:-https://raw.githubusercontent.com/16thdoc/Reparo/main/deploy/reparo-release.json}"
LATEST=0
DATA_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/reparo"
STATE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/reparo"
LOG_ROOT="$STATE_ROOT/logs"
PREVIEW=0
FORCE=0
INCLUDE=''
TAIL_LINES=120
HOST_NAME=$(hostname 2>/dev/null || printf unknown)
RUN_ID=''
RUN_RESULT=complete
NOT_UPDATED_FILE=''

usage() {
    cat <<'EOF'
Reparo Linux - native maintenance runner

Usage:
  reparo [--update] [--preview] [--force] [--include SECTION ...]
  reparo --new | --install | --status | --kill | --tail [--tail-lines COUNT]
  reparo --task daily 6am | --task hourly 12hr
  reparo --task 'weekdays at 5am,5pm' --task-name work --force --preview
  reparo --task --task-name work --task-action show
  reparo --version | --help

Modes:
  --update                 Run the detected native package manager plus present
                           Flatpak, Snap, fwupd, npm, and OpenCode.
  --force                  Include present developer toolchains: pipx, pnpm,
                           Yarn, .NET tools, rustup, Conda, gems, and Composer.
  --preview                Log and print commands without executing them.
  --include SECTION ...    Run only named sections (Apt, Dnf, Pacman, Zypper,
                           Flatpak, Snap, Fwupd, Npm, Opencode, Pipx, Pnpm,
                           Yarn, DotNet, Rust, Conda, Gem, Composer).
  --status                 Show other running Reparo Linux instances and logs.
  --kill                   Send SIGTERM only to other Reparo Linux instances.
  --tail                   Follow the newest Reparo Linux log.
  --tail-lines COUNT       Print this many lines before following a log. Default: 120.
  --new / --install        Verify pinned installer/runtime hashes and version.
  --latest                 Explicitly install unreviewed main (no release pin).
  --task RECURRENCE         Named current-user cron schedule: daily, selected days,
                            weekdays/weekends, monthly dates and multiple times.
                            Legacy hourly Nhr is a midnight-reset cron pattern.
                            Anchored every-N, ordinal and last-day calendars are
                            intentionally unsupported, not approximated.
  --task-name NAME          Owned schedule name (default: default).
  --task-action ACTION      create/list/show/enable/disable/remove.
  --task-replace            Explicitly replace an existing owned name.
                            --preview makes no change; preserve Force/Include.
  --version                Show the shared Reparo release identity.
  --help                   Show this help.

Every native command uses the full lexicon: `--name`, `-Name`, and `name` in
any casing, plus short forms with or without a dash. Short forms are Update/U,
Force/F, Preview/P, Include/C, Status, Kill/K, Tail/T, TailLines/TL,
Version/V, New/N, Install/I, and Help/H. `Log` is an alias for Tail.

Native package operations require root or passwordless sudo (sudo -n). Reparo
will skip rather than hang on a password prompt. Global npm installs under a system
prefix such as /usr/local use that same privilege path; user-owned npm prefixes do
not.

Native --new requires python3 for strict JSON validation and sha256sum for digests.
Both platforms validate immutable release artifacts before installation. Native
Install shares New's download behavior; Windows Install remains offline.
EOF
}

die() {
    printf '%s\n' "ERROR: $*" >&2
    exit 2
}

ensure_log_root() {
    if ! mkdir -p "$LOG_ROOT"; then
        die "Cannot create log directory: $LOG_ROOT"
    fi
    RUN_ID="$(printf '%s' "$HOST_NAME" | tr -cd '[:alnum:]._-')_$$_$(date +%Y%m%dT%H%M%S)"
    LOG_FILE="$LOG_ROOT/reparo_${RUN_ID}_RUNNING.log"
    : >"$LOG_FILE" || die "Cannot write log file: $LOG_FILE"
}

log() {
    stamp=$(date '+%Y-%m-%d %H:%M:%S')
    printf '%s %s\n' "$stamp" "$*" >>"$LOG_FILE"
    if [ -t 1 ] && [ "${NO_COLOR+x}" != x ] && [ "${TERM:-}" != dumb ]; then
        case "$*" in
            '[STEP] '*|'[CMD] '*|'[DRY-RUN] '*|'[SKIP] '*|'[WARN] '*|'[DONE] '*|'[FAIL] '*|'[ERROR] '*)
                message=$*; prefix=${message%% *}; rest=${message#* }; label=${rest%%:*}; detail=${rest#"$label"}
                color=33
                case "$prefix" in '[FAIL]'|'[ERROR]') color=31 ;; '[DONE]') color=32 ;; esac
                printf '%s \033[%sm%s\033[0m \033[31m%s\033[0m%s\n' "$stamp" "$color" "$prefix" "$label" "$detail" ;;
            *) printf '%s %s\n' "$stamp" "$*" ;;
        esac
    else
        printf '%s %s\n' "$stamp" "$*"
    fi
}

syslog_value() {
    # Graylog can extract these space-delimited key=value fields without receiving
    # unbounded package-manager output. Keep values to one safe token per field.
    printf '%s' "$1" | tr '[:space:]=' '__' | tr -cd '[:alnum:]_.:/-'
}

syslog_event() {
    priority=$1
    event=$2
    section=${3-}
    result=${4-}
    detail=${5-}
    [ -n "$section" ] || section='-'
    [ -n "$result" ] || result='-'
    [ -n "$detail" ] || detail='-'
    command_exists logger || return 0

    logger -p "user.$priority" -t reparo-linux -- \
        "event=$(syslog_value "$event") run_id=$(syslog_value "$RUN_ID") version=$REPARO_LINUX_VERSION host=$(syslog_value "$HOST_NAME") action=$(syslog_value "$ACTION") preview=$PREVIEW section=$(syslog_value "$section") result=$(syslog_value "$result") detail=$(syslog_value "$detail") log=$(syslog_value "${LOG_FILE:-}")" \
        >/dev/null 2>&1 || true
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

normalize_option() {
    option=$1
    case "$option" in
        --*) option=${option#--} ;;
        -*) option=${option#-} ;;
    esac
    printf '%s' "$option" | tr '[:upper:]' '[:lower:]'
}

windows_only_option() {
    case "$1" in
        windowsupdate|wu|windows11upgrade|win11|windows11|upgradetowindows11|powershell7only|7|powershell7|sevenzip|7zip|7z|wslapt|wsl|winget|wg|wingetdiscover|wd|search|list|versionlock|vl|addversionlock|saveversionlock|avl|versionlockpath|vlp|listversionlocks|lvl|migratechocotowinget|mcw|chocoderegisteronly|cdo|forcewingetreinstall|fwr|allowruntimederegister|ard|allowportablederegister|apd|finalizechocolateyremoval|fcr|allowremainingchocopackages|nochocolateybackup|migrationreportpath|chocowingetmappath|cwm|migratechocoexclude|mce|checkapp|lockapp|lockversion|packagemanager|ignoretimeouts|it|wingettimeoutseconds|wts|wingetdiscoverytimeoutseconds|wdts|windowsupdatetimeoutseconds|wuts|wslapttimeoutseconds|wats|snaptimeoutseconds|sts|installnugetprovider|inp|allowreboot|allowrestart|ar|forcereboot|reboot|restart|r|forcerestart|fr|fs|frst|forceshutdown|shutdown|poweroff|forcepoweroff|fsh|s|logroot|lr|syslog|installroot|ir|sourceurl|su|nobackup|nb|sweep|sweepstale|clean|prune|sw|deletestale|ds|time|at)
            return 0
            ;;
        *) return 1 ;;
    esac
}

report_native_result() {
    [ "${REPARO_REPORT_SKIP:-0}" != 1 ] || return 0
    reporting_root="$STATE_ROOT/reporting"
    [ -f "$reporting_root/reporting-client.json" ] || return 0
    case "$reporting_root" in */Proton/*|*/Dropbox/*|*/GitHub/*|*/.git/*) return 0 ;; esac
    command_exists python3 && command_exists timeout || return 0
    # Parent argv contains outcome/version facts only, never a credential. All
    # private file/hash/network work is inside this 25-second owned process group.
    timeout -k 1 25 python3 - "$reporting_root" "$DATA_ROOT/reparo-linux" "$1" "$2" "$3" "$4" <<'PY' >/dev/null 2>&1 || true
import datetime, hashlib, json, os, pathlib, re, stat, subprocess, sys, uuid
try:
    root, runtime, kind, method, outcome, previous = sys.argv[1:]
    def private(p, directory=False):
        at=pathlib.Path(p)
        while True:
            if at.is_symlink(): raise ValueError()
            if at.parent == at: break
            at=at.parent
        s=os.stat(p, follow_symlinks=False)
        if s.st_uid != os.getuid() or stat.S_IMODE(s.st_mode) != (0o700 if directory else 0o600): raise ValueError()
        if directory and not stat.S_ISDIR(s.st_mode): raise ValueError()
        if not directory and (not stat.S_ISREG(s.st_mode) or s.st_nlink != 1): raise ValueError()
    def read_json(p, limit):
        private(p)
        with open(p,'rb') as f: raw=f.read(limit+1)
        if len(raw)>limit: raise ValueError()
        def unique(pairs):
            result={}
            for k,v in pairs:
                if k in result: raise ValueError()
                result[k]=v
            return result
        return json.loads(raw, object_pairs_hook=unique)
    def digest(p):
        h=hashlib.sha256()
        with open(p,'rb') as f:
            for b in iter(lambda:f.read(65536),b''): h.update(b)
        return h.hexdigest().upper()
    private(root, True)
    config=read_json(os.path.join(root,'reporting-client.json'),4096)
    if set(config) != {'enabled','manifestSha256','nodePath','nodeSha256','schema'} or config['schema'] != 'reparo-reporting-client-1': raise ValueError()
    if config['enabled'] is not True: sys.exit(0)
    node=config['nodePath']
    if not isinstance(node,str) or not os.path.isabs(node) or os.path.islink(node): raise ValueError()
    for field in ['nodeSha256','manifestSha256']:
        if not isinstance(config[field],str) or not re.fullmatch('[A-F0-9]{64}',config[field]): raise ValueError()
    if digest(node) != config['nodeSha256']: raise ValueError()
    package=os.path.join(root,'client')
    for directory in [package,os.path.join(package,'src'),os.path.join(package,'scripts')]: private(directory,True)
    manifest_path=os.path.join(package,'client-manifest.json')
    manifest=read_json(manifest_path,8192)
    if digest(manifest_path) != config['manifestSha256']: raise ValueError()
    required={'src/bounded-client.js','src/collector-client.js','src/collector-client-state.js','src/protected-client-files.js','src/receipt-contract.js','scripts/client-report-worker.js','scripts/report-client-cli.js','package.json'}
    if manifest.get('schema') != 'reparo-client-bundle-prototype-1' or set(manifest['files']) != required: raise ValueError()
    for name in required:
        p=os.path.join(package,name); private(p)
        if digest(p) != manifest['files'][name]: raise ValueError()
    current=None
    if os.path.isfile(runtime):
        with open(runtime,'r',encoding='utf-8') as f: text=f.read(1048576)
        found=re.findall(r"^REPARO_LINUX_VERSION='([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)'$",text,re.M)
        if len(found)==1: current=found[0]
    previous=previous if re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+',previous) else None
    if kind=='lifecycle_result':
        if outcome=='succeeded' and current is None: outcome='unknown'
        data={'method':method,'previous_version':previous,'current_version':current,'outcome':outcome,'duration_ms':None,'failure_code':'LIFECYCLE_FAILED' if outcome=='failed' else None}
    else:
        # Native managers do batch commands, not verified per-package receipts.
        # Preserve unknown counts rather than comparing commands with packages.
        data={'outcome':outcome,'updated':None,'skipped':None,'failed':None,'duration_ms':None}
    machine=os.uname().machine
    arch={'x86_64':'x64','aarch64':'arm64','i386':'x86','i686':'x86','armv7l':'arm'}.get(machine,'unknown')
    template={'event_type':kind,'event_id':str(uuid.uuid4()),'run_id':str(uuid.uuid4()),'client_time':datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='milliseconds').replace('+00:00','Z'),
      'host':{'os_family':'linux','os_version':os.uname().release,'os_build':None,'architecture':arch,'runtime_version':None,'context':'native-root' if os.getuid()==0 else 'native-user'},'data':data}
    env=dict(os.environ,NODE_OPTIONS='',NODE_TLS_REJECT_UNAUTHORIZED='1')
    subprocess.run([node,os.path.join(package,'scripts/report-client-cli.js')],input=json.dumps({'enabled':True,'root':root,'storageMode':'user','template':template}).encode(),stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,env=env,check=False)
except Exception:
    pass # Never change the caller's installation/maintenance result.
PY
    return 0
}

native_install_finalization() {
    status=$?
    [ -z "${bootstrap_dir:-}" ] || rm -rf "$bootstrap_dir"
    outcome=failed
    if [ "$status" -eq 0 ]; then
        if [ "$PREVIEW" -eq 1 ]; then outcome=preview; else outcome=succeeded; fi
    fi
    report_native_result lifecycle_result native-installer "$outcome" "${reporting_previous_version:-}"
    exit "$status"
}

run_native_installer() {
    if [ "$PREVIEW" -eq 1 ]; then printf '%s\n' 'Preview: no installer download, runtime replacement or scheduling performed.'; return 0; fi
    for required in curl mktemp; do
        command_exists "$required" || die "$required is required to install or update Reparo Linux"
    done

    bootstrap_dir=$(mktemp -d "${TMPDIR:-/tmp}/reparo-linux-bootstrap.XXXXXX") || die 'Cannot create installer workspace'
    trap native_install_finalization EXIT
    bootstrap_path="$bootstrap_dir/install-reparo-linux.sh"
    release_file="$bootstrap_dir/release.json"
    installer_hash=''
    if [ -n "$REPARO_INSTALLER_URL" ] || [ "$LATEST" -eq 1 ]; then
        REPARO_INSTALLER_URL="${REPARO_INSTALLER_URL:-https://raw.githubusercontent.com/16thdoc/Reparo/main/deploy/install-reparo-linux.sh}"
        printf '%s\n' 'WARNING: Explicit latest/custom installer is unpinned.'
    else
        command_exists python3 || die 'python3 is required for strict release-manifest validation'
        command_exists sha256sum || die 'sha256sum is required for release verification'
        curl --proto '=https' --proto-redir '=https' --connect-timeout 10 --max-time 60 -fsSL "$REPARO_RELEASE_URL" -o "$release_file" || die 'Could not download release manifest'
        release_values=$(python3 - "$release_file" <<'PY'
import json, re, sys
try:
    raw = open(sys.argv[1], 'rb').read(16385)
    if len(raw) > 16384: raise ValueError()
    def unique(pairs):
        result = {}
        for k, v in pairs:
            if k in result: raise ValueError()
            result[k] = v
        return result
    m = json.loads(raw, object_pairs_hook=unique)
    if not re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+', m['version']): raise ValueError()
    if not re.fullmatch(r'[0-9a-f]{40}', m['commit']): raise ValueError()
    base = 'https://raw.githubusercontent.com/16thdoc/Reparo/' + m['commit'] + '/'
    for url, digest, path in [('linuxUrl', 'linuxSha256', 'linux/reparo-linux'), ('linuxInstallerUrl', 'linuxInstallerSha256', 'deploy/install-reparo-linux.sh')]:
        if m[url] != base + path or not re.fullmatch(r'[A-F0-9]{64}', m[digest]): raise ValueError()
    print(m['linuxInstallerUrl']); print(m['linuxInstallerSha256'])
except (ValueError, TypeError, KeyError, OSError):
    sys.exit('ERROR: Invalid immutable Linux release manifest.')
PY
        ) || die 'Invalid release manifest; refusing unpinned fallback'
        REPARO_INSTALLER_URL=$(printf '%s\n' "$release_values" | sed -n '1p')
        installer_hash=$(printf '%s\n' "$release_values" | sed -n '2p')
    fi
    printf '%s\n' "Downloading native Reparo installer: $REPARO_INSTALLER_URL"
    if ! curl --proto '=https' --proto-redir '=https' --connect-timeout 10 --max-time 60 -fsSL -H 'Cache-Control: no-cache' -H 'Pragma: no-cache' "$REPARO_INSTALLER_URL" -o "$bootstrap_path"; then
        rm -rf "$bootstrap_dir"
        die 'Could not download native Reparo installer'
    fi
    if [ -n "$installer_hash" ]; then
        actual_hash=$(sha256sum "$bootstrap_path" | cut -d ' ' -f 1 | tr '[:lower:]' '[:upper:]')
        [ "$actual_hash" = "$installer_hash" ] || die 'Installer SHA-256 does not match release pin; refusing execution'
    fi
    if [ ! -s "$bootstrap_path" ] || ! sh -n "$bootstrap_path"; then
        rm -rf "$bootstrap_dir"
        die 'Downloaded installer is empty or fails POSIX shell syntax validation'
    fi

    printf '%s\n' 'Running native Reparo installer...'
    if [ -n "$installer_hash" ]; then
        if REPARO_REPORT_SKIP=1 REPARO_URL='' REPARO_RELEASE_FILE="$release_file" sh "$bootstrap_path" --verbose; then status=0; else status=$?; fi
    else
        if REPARO_REPORT_SKIP=1 sh "$bootstrap_path" --verbose --latest; then status=0; else status=$?; fi
    fi
    rm -rf "$bootstrap_dir"
    return "$status"
}

quote_shell() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

resolve_cron_recurrence() {
    printf '%s\n' "$TASK_TEXT" | awk '
    function fail(message) { print message > "/dev/stderr"; exit 2 }
    {
        text=tolower($0); gsub(/,/, " ", text)
        if (text ~ /[^a-z0-9: ]/) fail("Unsafe recurrence characters")
        if (text ~ /^hourly /) {
            n=split(text,w," "); h=w[2]; sub(/hr$/, "",h)
            if (h !~ /^[0-9]+$/ || h<1 || h>23 || n!=2) fail("Hourly needs 1hr through 23hr")
            print "0 */" h " * * *"; exit
        }
        if (text ~ /(^| )(first|second|third|fourth|last|every)( |$)/) fail("Anchored intervals/ordinal/last-day recurrence is Windows-only; cron must not approximate it")
        day["sunday"]=0; day["monday"]=1; day["tuesday"]=2; day["wednesday"]=3; day["thursday"]=4; day["friday"]=5; day["saturday"]=6
        n=split(text,w,/ +/); dow=""; dom=""; count=0
        for(i=1;i<=n;i++) {
            word=w[i]; if(word=="" || word=="at" || word=="and" || word=="daily" || word=="weekly" || word=="monthly") continue
            if(word=="weekdays") { dow="1,2,3,4,5"; continue }
            if(word=="weekends") { dow="0,6"; continue }
            if(word ~ /am$|pm$|:/) {
                meridian=""; if(word ~ /am$|pm$/) { meridian=substr(word,length(word)-1); sub(/am$|pm$/, "",word) }
                if((meridian=="" && word !~ /^[0-9][0-9]?:[0-9][0-9]$/) || (meridian!="" && word !~ /^[0-9][0-9]?(:[0-9][0-9])?$/)) fail("Invalid clock time")
                split(word,t,":"); hour=t[1]+0; minute=(t[2]==""?0:t[2]+0)
                if((meridian=="" && word !~ /:/) || hour>23 || minute>59 || (meridian!="" && (hour<1 || hour>12))) fail("Invalid clock range")
                if(meridian!="") { if(hour==12) hour=0; if(meridian=="pm") hour+=12 }
                hours[++count]=hour; minutes[count]=minute; continue
            }
            sub(/s$/, "",word)
            if(word in day) { dow=dow (dow==""?"":",") day[word]; continue }
            sub(/st$|nd$|rd$|th$/, "",word)
            if(word ~ /^[0-9]+$/ && word>=1 && word<=31) { dom=dom (dom==""?"":",") word; continue }
            fail("Unknown calendar word: " word)
        }
        if(count==0 || (dom!="" && dow!="")) fail("Missing time or mixed month/day recurrence")
        if(dom=="") dom="*"; if(dow=="") dow="*"
        for(i=1;i<=count;i++) print minutes[i] " " hours[i] " " dom " * " dow
    }'
}

read_crontab_state() {
    errors=$(mktemp "${TMPDIR:-/tmp}/reparo-crontab-read.XXXXXX") || return 1
    if state=$(LC_ALL=C crontab -l 2>"$errors"); then
        rm -f "$errors"
        printf '%s' "$state"
        return 0
    else
        read_status=$?
    fi
    if [ "$read_status" -eq 1 ] && [ "$(wc -l <"$errors")" -eq 1 ] && grep -Eq '^(no crontab for|crontab: no crontab for) ' "$errors"; then
        rm -f "$errors"
        return 0
    fi
    rm -f "$errors"
    printf '%s\n' 'Cannot read existing crontab; refusing to treat an access/tool failure as empty.' >&2
    return 1
}

configure_persistent_task() {
    case "$TASK_NAME" in ''|*[!A-Za-z0-9_-]*) die 'Task name must use letters, digits, underscore or hyphen' ;; esac
    [ "${#TASK_NAME}" -le 64 ] || die 'Task name too long'
    marker="# Reparo managed task v2:$TASK_NAME"
    command_exists crontab || { [ "$PREVIEW" -eq 1 ] && [ "$TASK_ACTION" = create ]; } || die 'crontab is required for task management'
    case "$TASK_ACTION" in
        create|enable|disable|remove)
            if [ "$PREVIEW" -eq 0 ]; then
                command_exists flock || die 'flock is required for serialized task management'
                mkdir -p "$STATE_ROOT" || die 'Cannot create local task state directory'
                exec 9>"$STATE_ROOT/task-management.lock"
                flock -n 9 || die 'Another Reparo task manager owns the crontab; no changes made'
            fi ;;
    esac
    if command_exists crontab; then existing=$(read_crontab_state) || die 'Existing crontab is unverified; no changes made'; else existing=''; fi
    owned=$(printf '%s\n' "$existing" | awk -v marker="$marker" 'substr($0,length($0)-length(marker)+1)==marker')
    case "$TASK_ACTION" in
        list) printf '%s\n' "$existing" | awk '/# Reparo managed task v2:[A-Za-z0-9_-]+$/'; return ;;
        show) [ -n "$owned" ] || die 'Owned task does not exist'; printf '%s\n' "$owned"; return ;;
        create|enable|disable|remove) ;;
        *) die 'Task action must be create/list/show/enable/disable/remove' ;;
    esac
    if [ "$TASK_ACTION" = create ]; then
        schedules=$(resolve_cron_recurrence) || die 'Invalid/unsupported recurrence'
        runner=$0
        case "$runner" in /*) ;; *) die 'Use an absolute runtime path for cron' ;; esac
        # Cron interprets percent and newlines before invoking a shell, even in quotes.
        case "$runner$STATE_ROOT$INCLUDE" in *%*|*'
'*) die 'Cron paths/arguments cannot contain percent or newline' ;; esac
        action='--update'; [ "$FORCE" -eq 1 ] && action='--force'
        if [ -n "$INCLUDE" ]; then
            case "$INCLUDE" in *[!A-Za-z0-9_\|.-]*) die 'Scheduled section names must be plain supported section tokens' ;; esac
            action="$action --include"
            for section in $(printf '%s' "$INCLUDE" | tr '|' ' '); do action="$action $(quote_shell "$section")"; done
        fi
        lock="$STATE_ROOT/task-$TASK_NAME.lock"
        worker="flock -n $(quote_shell "$lock") sh $(quote_shell "$runner") $action"
        printf '%s\n' "Task: $TASK_NAME | user: $(id -un) | local cron timezone | POWER: no reboot | overlap: flock IgnoreNew | missed: not replayed" "Command: $worker" "$schedules"
        if [ "$PREVIEW" -eq 1 ]; then printf '%s\n' 'Preview only; no crontab changed'; return; fi
        [ -z "$owned" ] || [ "$TASK_REPLACE" -eq 1 ] || die 'Task exists; use --task-replace explicitly'
        command_exists flock || die 'flock is required to protect overlapping scheduled runs'
        mkdir -p "$STATE_ROOT" || die 'Cannot create task lock directory'
    else
        [ -n "$owned" ] || die 'Owned task does not exist'
        if [ "$PREVIEW" -eq 1 ]; then printf '%s\n' "Preview: $TASK_ACTION $TASK_NAME; no crontab changed"; return; fi
    fi
    temp_crontab=$(mktemp "${TMPDIR:-/tmp}/reparo-crontab.XXXXXX") || die 'Cannot create temporary crontab'
    if [ -n "$existing" ]; then
        printf '%s\n' "$existing" | awk -v marker="$marker" 'substr($0,length($0)-length(marker)+1)!=marker' >"$temp_crontab"
    else
        : >"$temp_crontab"
    fi
    case "$TASK_ACTION" in
        create) printf '%s\n' "$schedules" | while IFS= read -r schedule; do printf '%s %s %s\n' "$schedule" "$worker" "$marker"; done >>"$temp_crontab" ;;
        disable) printf '%s\n' "$owned" | sed '/^# DISABLED /!s/^/# DISABLED /' >>"$temp_crontab" ;;
        enable) printf '%s\n' "$owned" | sed 's/^# DISABLED //' >>"$temp_crontab" ;;
    esac
    current=$(read_crontab_state) || { rm -f "$temp_crontab"; die 'Crontab recheck failed; no changes made'; }
    [ "$current" = "$existing" ] || { rm -f "$temp_crontab"; die 'Crontab changed concurrently; refusing to overwrite it'; }
    crontab "$temp_crontab" || { rm -f "$temp_crontab"; die 'Could not install the Reparo crontab entry'; }
    rm -f "$temp_crontab"
    printf '%s\n' "Task $TASK_ACTION complete: $TASK_NAME (unrelated and legacy schedules preserved)"
}

normalize_section() {
    case "$1" in
        apt|Apt) printf '%s' Apt ;;
        dnf|Dnf) printf '%s' Dnf ;;
        pacman|Pacman) printf '%s' Pacman ;;
        zypper|Zypper) printf '%s' Zypper ;;
        flatpak|Flatpak) printf '%s' Flatpak ;;
        snap|Snap) printf '%s' Snap ;;
        fwupd|Fwupd) printf '%s' Fwupd ;;
        npm|Npm) printf '%s' Npm ;;
        opencode|OpenCode|Opencode) printf '%s' Opencode ;;
        pipx|Pipx) printf '%s' Pipx ;;
        pnpm|Pnpm) printf '%s' Pnpm ;;
        yarn|Yarn) printf '%s' Yarn ;;
        dotnet|DotNet) printf '%s' DotNet ;;
        rust|Rust|rustup) printf '%s' Rust ;;
        conda|Conda) printf '%s' Conda ;;
        gem|Gem|gems) printf '%s' Gem ;;
        composer|Composer) printf '%s' Composer ;;
        *) return 1 ;;
    esac
}

add_include() {
    section=$(normalize_section "$1") || die "Unknown section: $1"
    case "|$INCLUDE|" in
        *"|$section|"*) ;;
        *) INCLUDE="${INCLUDE}${INCLUDE:+|}${section}" ;;
    esac
}

section_selected() {
    section=$1
    if [ -n "$INCLUDE" ]; then
        case "|$INCLUDE|" in *"|$section|"*) return 0 ;; *) return 1 ;; esac
    fi

    case "$section" in
        Apt|Dnf|Pacman|Zypper|Flatpak|Snap|Fwupd|Npm|Opencode) return 0 ;;
        Pipx|Pnpm|Yarn|DotNet|Rust|Conda|Gem|Composer) [ "$FORCE" -eq 1 ] ;;
        *) return 1 ;;
    esac
}

record_not_updated() {
    outcome=$1
    section=$2
    reason=$3
    action=$4
    printf '%s\t%s\t%s\t%s\n' "$outcome" "$section" "$reason" "$action" >>"$NOT_UPDATED_FILE"
}

print_not_updated_report() {
    count=$(wc -l <"$NOT_UPDATED_FILE" | tr -d '[:space:]')
    [ "$count" -gt 0 ] 2>/dev/null || { log 'Not updated: none'; rm -f "$NOT_UPDATED_FILE"; return; }
    log "Not updated: reasons and actions ($count)"
    tab=$(printf '\t')
    while IFS="$tab" read -r outcome section reason action; do
        log "  - $section - $outcome"
        log "      Why: $reason"
        log "      Next: $action"
    done <"$NOT_UPDATED_FILE"
    rm -f "$NOT_UPDATED_FILE"
}

detect_native_section() {
    distro=''
    if [ -r /etc/os-release ]; then
        # os-release is the distro's declarative environment file, not user input.
        # shellcheck disable=SC1091
        . /etc/os-release
        distro="${ID:-} ${ID_LIKE:-}"
    fi

    case "$distro" in
        *kali*|*debian*|*ubuntu*|*linuxmint*|*pop*) printf '%s' Apt ;;
        *fedora*|*rhel*|*centos*|*rocky*|*almalinux*) printf '%s' Dnf ;;
        *arch*|*manjaro*) printf '%s' Pacman ;;
        *suse*|*opensuse*|*sles*) printf '%s' Zypper ;;
        *)
            if command_exists apt-get; then printf '%s' Apt
            elif command_exists dnf; then printf '%s' Dnf
            elif command_exists pacman; then printf '%s' Pacman
            elif command_exists zypper; then printf '%s' Zypper
            else printf '%s' Unknown
            fi
            ;;
    esac
}

run_command() {
    section=$1
    description=$2
    shift 2
    log "[CMD] $section: $description"
    syslog_event notice command_start "$section" running "$description"
    if [ "$PREVIEW" -eq 1 ]; then
        log "[DRY-RUN] $section: $description"
        syslog_event notice command_preview "$section" skipped "$description"
        record_not_updated SKIPPED "$section" 'preview only' 'Rerun without --preview when you want Reparo to make changes.'
        return 0
    fi

    output_file=$(mktemp "${TMPDIR:-/tmp}/reparo-linux-command.XXXXXX") || {
        log "[FAIL] $section: could not create command output file"
        record_not_updated FAILED "$section" 'could not create command output file' 'Check temporary-directory permissions, then rerun the affected section.'
        return 1
    }
    if "$@" >"$output_file" 2>&1; then
        status=0
    else
        status=$?
    fi
    cat "$output_file" | tee -a "$LOG_FILE"
    rm -f "$output_file"
    if [ "$status" -eq 0 ]; then
        log "[DONE] $section"
        syslog_event notice command_complete "$section" success "$description"
    else
        log "[FAIL] $section exited $status"
        RUN_RESULT=partial
        syslog_event err command_complete "$section" failed "exit_$status"
        record_not_updated FAILED "$section" "command exited $status" 'Inspect the final log, correct the reported error, and rerun the affected section.'
    fi
    return "$status"
}

run_privileged() {
    section=$1
    description=$2
    shift 2
    if [ "$PREVIEW" -eq 1 ]; then
        run_command "$section" "$description" "$@"
    elif [ "$(id -u)" -eq 0 ]; then
        run_command "$section" "$description" "$@"
    elif command_exists sudo && sudo -n true >/dev/null 2>&1; then
        run_command "$section" "$description" sudo -n "$@"
    else
        log "[SKIP] $section: root or passwordless sudo is required; refusing to prompt"
        syslog_event warning command_skipped "$section" skipped 'privilege_required'
        record_not_updated SKIPPED "$section" 'root or passwordless sudo is required' 'Run Reparo as root or configure passwordless sudo for the required package-manager commands.'
        return 0
    fi
}

run_optional() {
    section=$1
    executable=$2
    shift 2
    if ! section_selected "$section"; then return 0; fi
    if ! command_exists "$executable"; then
        log "[SKIP] $section: $executable not found"
        syslog_event notice command_skipped "$section" skipped 'tool_not_found'
        record_not_updated SKIPPED "$section" "$executable not found" 'Install or repair this tool only if you expect Reparo to manage it.'
        return 0
    fi
    run_command "$section" "$*" "$@" || true
}

npm_system_scope() {
    npm_root=$("$npm_executable" root -g 2>/dev/null || true)
    npm_prefix=$("$npm_executable" config get prefix 2>/dev/null || true)
    case "$npm_root" in
        /usr/*|/opt/*) return 0 ;;
    esac
    case "$npm_prefix" in
        /usr|/usr/*|/opt|/opt/*) return 0 ;;
    esac
    [ -n "$npm_root" ] && [ -e "$npm_root" ] && [ ! -w "$npm_root" ]
}

run_npm_global_update() {
    section_selected Npm || return 0
    if ! command_exists npm; then
        log '[SKIP] Npm: npm not found'
        syslog_event notice command_skipped Npm skipped tool_not_found
        record_not_updated SKIPPED Npm 'npm not found' 'Install or repair npm only if you expect Reparo to manage it.'
        return 0
    fi
    npm_executable=$(command -v npm)

    # Preview is a strict non-executing mode: do not even query npm configuration.
    if [ "$PREVIEW" -eq 1 ]; then
        run_command Npm 'npm update -g' "$npm_executable" update -g || true
    elif npm_system_scope; then
        log '[INFO] Npm: detected system global prefix; using root or passwordless sudo'
        syslog_event notice npm_scope Npm detected system_global
        run_privileged Npm 'npm update -g (system global prefix)' "$npm_executable" update -g || true
    else
        run_command Npm 'npm update -g' "$npm_executable" update -g || true
    fi
}

run_opencode_update() {
    section_selected Opencode || return 0
    if ! command_exists opencode; then
        log '[SKIP] Opencode: opencode not found'
        syslog_event notice command_skipped Opencode skipped tool_not_found
        record_not_updated SKIPPED Opencode 'opencode not found' 'Install OpenCode only if you expect Reparo to update it.'
        return 0
    fi
    if ! command_exists npm; then
        log '[SKIP] Opencode: npm not found; cannot update npm-managed installation'
        syslog_event notice command_skipped Opencode skipped npm_not_found
        record_not_updated SKIPPED Opencode 'npm not found for an npm-managed installation' 'Install or repair npm, then rerun the Opencode section.'
        return 0
    fi

    opencode_path=$(command -v opencode)
    opencode_prefix=$(dirname "$(dirname "$opencode_path")")
    opencode_package="$opencode_prefix/lib/node_modules/opencode-ai"
    if [ ! -d "$opencode_package" ]; then
        log "[SKIP] Opencode: $opencode_path is not a standard npm global installation"
        syslog_event notice command_skipped Opencode skipped unsupported_installation
        record_not_updated SKIPPED Opencode 'active command is not a standard npm global installation' 'Update OpenCode through the installer or package manager that owns the active command.'
        return 0
    fi

    npm_executable=$(command -v npm)
    # Do not invoke `opencode upgrade`: it prompts before modifying an npm-owned
    # executable, and its npm method follows npm's configured prefix rather than the
    # prefix that owns the active OpenCode command. Update that owning prefix directly.
    case "$opencode_prefix" in
        /usr|/usr/*|/opt|/opt/*)
            run_privileged Opencode 'npm install --global opencode-ai@latest (owning prefix)' "$npm_executable" install --global --prefix "$opencode_prefix" opencode-ai@latest || true
            ;;
        *)
            run_command Opencode 'npm install --global opencode-ai@latest (owning prefix)' "$npm_executable" install --global --prefix "$opencode_prefix" opencode-ai@latest || true
            ;;
    esac
}

run_native_manager() {
    native_section=$(detect_native_section)
    if ! section_selected "$native_section"; then return 0; fi
    case "$native_section" in
        Apt)
            command_exists apt-get || { log '[SKIP] Apt: apt-get not found'; syslog_event notice command_skipped Apt skipped tool_not_found; return; }
            run_privileged Apt 'apt-get update' env DEBIAN_FRONTEND=noninteractive apt-get update || return
            run_privileged Apt 'apt-get -y upgrade' env DEBIAN_FRONTEND=noninteractive apt-get -y upgrade || return
            run_privileged Apt 'apt-get -y autoremove' env DEBIAN_FRONTEND=noninteractive apt-get -y autoremove || return
            ;;
        Dnf)
            command_exists dnf || { log '[SKIP] Dnf: dnf not found'; syslog_event notice command_skipped Dnf skipped tool_not_found; return; }
            run_privileged Dnf 'dnf -y upgrade' dnf -y upgrade || return
            run_privileged Dnf 'dnf -y autoremove' dnf -y autoremove || return
            ;;
        Pacman)
            command_exists pacman || { log '[SKIP] Pacman: pacman not found'; syslog_event notice command_skipped Pacman skipped tool_not_found; return; }
            run_privileged Pacman 'pacman -Syu --noconfirm' pacman -Syu --noconfirm || return
            ;;
        Zypper)
            command_exists zypper || { log '[SKIP] Zypper: zypper not found'; syslog_event notice command_skipped Zypper skipped tool_not_found; return; }
            run_privileged Zypper 'zypper --non-interactive refresh' zypper --non-interactive refresh || return
            run_privileged Zypper 'zypper --non-interactive update' zypper --non-interactive update || return
            ;;
        *) log '[SKIP] Native: no supported package manager detected'; syslog_event warning command_skipped Native skipped no_supported_manager; record_not_updated SKIPPED Native 'no supported package manager detected' 'Use the distribution package manager manually.' ;;
    esac
}

latest_log() {
    latest=''
    for candidate in "$LOG_ROOT"/reparo_*.log; do
        [ -f "$candidate" ] || continue
        if [ -z "$latest" ] || [ "$candidate" -nt "$latest" ]; then latest=$candidate; fi
    done
    printf '%s' "$latest"
}

list_reparo_processes() {
    grep -al 'reparo-linux' /proc/[0-9]*/cmdline 2>/dev/null | while IFS= read -r cmdline_path; do
        proc=${cmdline_path%/cmdline}
        pid=${proc#/proc/}
        process_is_current_tree "$pid" && continue
        cmdline=$({ tr '\000' ' ' <"$cmdline_path"; } 2>/dev/null || true)
        # The command line may merely mention Reparo (for example a shellcheck
        # invocation). The runtime script must be argv[1], as it is for both the
        # executable script and the installed sh shim.
        script_path=$({ tr '\000' '\n' <"$cmdline_path" | awk 'NR == 2 { print; exit }'; } 2>/dev/null || true)
        case "$script_path" in */reparo-linux|reparo-linux) printf '%s\t%s\n' "$pid" "$cmdline" ;; esac
    done
}

process_parent_id() {
    awk '/^PPid:/{print $2; exit}' "/proc/$1/status" 2>/dev/null
}

build_protected_processes() {
    PROTECTED_PROCESSES=" $$ "
    parent=$(process_parent_id "$$")
    while [ -n "$parent" ] && [ "$parent" -gt 1 ] 2>/dev/null; do
        PROTECTED_PROCESSES="${PROTECTED_PROCESSES}${parent} "
        parent=$(process_parent_id "$parent")
    done
}

process_is_current_tree() {
    candidate=$1
    case "$PROTECTED_PROCESSES" in *" $candidate "*) return 0 ;; esac
    while [ -n "$candidate" ] && [ "$candidate" -gt 1 ] 2>/dev/null; do
        [ "$candidate" = "$$" ] && return 0
        candidate=$(process_parent_id "$candidate")
    done
    return 1
}

show_status() {
    ensure_log_root
    log "Reparo Linux $REPARO_LINUX_VERSION status"
    syslog_event notice status -- success requested
    log "Log root: $LOG_ROOT"
    processes=$(list_reparo_processes)
    if [ -n "$processes" ]; then
        log 'Running Reparo Linux processes:'
        printf '%s\n' "$processes" | tee -a "$LOG_FILE"
    else
        log 'Running: none'
    fi
    latest=$(latest_log)
    if [ -n "$latest" ]; then log "Latest log: $latest"; else log 'Latest log: none'; fi
}

kill_reparo_processes() {
    ensure_log_root
    syslog_event notice kill -- requested requested
    processes=$(list_reparo_processes)
    if [ -z "$processes" ]; then
        log 'No other Reparo Linux process found.'
        syslog_event notice kill -- success none_found
        return 0
    fi
    printf '%s\n' "$processes" | while IFS="$(printf '\t')" read -r pid cmdline; do
        log "[KILL] SIGTERM PID $pid: $cmdline"
        if kill -TERM "$pid" 2>/dev/null; then log "[DONE] stopped PID $pid"; syslog_event warning kill Reparo success "pid_$pid"; else log "[FAIL] could not stop PID $pid"; syslog_event err kill Reparo failed "pid_$pid"; fi
    done
}

tail_log() {
    mkdir -p "$LOG_ROOT" || die "Cannot create log directory: $LOG_ROOT"
    latest=$(latest_log)
    [ -n "$latest" ] || die "No Reparo Linux log found in $LOG_ROOT"
    printf '%s\n' "Following $latest"
    tail -n "$TAIL_LINES" -f "$latest"
}

parse_args() {
    while [ "$#" -gt 0 ]; do
        original_option=$1
        option=$(normalize_option "$original_option")
        if [ "$ACTION" = task ]; then
            case "$option" in new|n|install|i|latest|report-lifecycle|status|s|kill|k|tail|t|log|version|v|help|h) die 'Task cannot schedule lifecycle or utility modes' ;; esac
        fi
        case "$option" in
            update|u) ;;
            force|f) FORCE=1 ;;
            preview|p) PREVIEW=1 ;;
            status|s) ACTION=status ;;
            kill|k) ACTION=kill ;;
            tail|t|log) ACTION=tail ;;
            version|v) ACTION=version ;;
            new|n|install|i) ACTION=install ;;
            latest) ACTION=install; LATEST=1 ;;
            report-lifecycle) ACTION=report-lifecycle ;;
            task)
                [ "$ACTION" = update ] || die 'Task cannot be combined with lifecycle/utility actions'
                ACTION=task ;;
            task-name|taskname) shift; [ "$#" -gt 0 ] || die '--task-name needs a name'; TASK_NAME=$1; TASK_CONTROLS=1 ;;
            task-action|taskaction) shift; [ "$#" -gt 0 ] || die '--task-action needs an action'; TASK_ACTION=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]'); TASK_CONTROLS=1 ;;
            task-replace|taskreplace) TASK_REPLACE=1; TASK_CONTROLS=1 ;;
            help|h) ACTION=help ;;
            tail-lines|taillines|tl)
                shift; [ "$#" -gt 0 ] || die '--tail-lines needs a positive number'
                TAIL_LINES=$1 ;;
            include|c)
                shift
                [ "$#" -gt 0 ] || die '--include needs at least one section'
                while [ "$#" -gt 0 ]; do
                    case "$1" in -*) break ;; *) add_include "$1"; shift ;; esac
                done
                continue ;;
            *)
                if [ "$ACTION" = task ]; then
                    case "$original_option" in -*) die "Unsupported scheduling option: $original_option" ;; esac
                    TASK_TEXT="${TASK_TEXT}${TASK_TEXT:+ }$original_option"; shift; continue
                fi
                if windows_only_option "$option"; then
                    die "$original_option is currently Windows-only; Linux does not pretend otherwise"
                fi
                die "Unknown option: $original_option"
                ;;
        esac
        shift
    done
    case "$TAIL_LINES" in ''|*[!0-9]*) die '--tail-lines must be a positive integer' ;; esac
    [ "$TAIL_LINES" -gt 0 ] || die '--tail-lines must be greater than zero'
    [ "$TASK_CONTROLS" -eq 0 ] || [ "$ACTION" = task ] || die 'Task controls require --task; refusing accidental maintenance'
}

ACTION=update
TASK_TEXT=''
TASK_NAME=default
TASK_ACTION=create
TASK_REPLACE=0
TASK_CONTROLS=0
parse_args "$@"
[ "$ACTION" != report-lifecycle ] || [ "$#" -eq 1 ] || die 'Report utility cannot run other operations'
build_protected_processes
case "$ACTION" in
    help) usage; exit 0 ;;
    version)
        printf '%s\n' "Reparo Linux $REPARO_LINUX_VERSION"
        printf '%s\n' "Runtime: $0"
        printf '  "%s"\n' "$REPARO_VERSION_QUOTE"
        printf '  - %s\n' "$REPARO_VERSION_SOURCE"
        printf '%s\n' "$REPARO_VERSION_ART"
        exit 0
        ;;
    report-lifecycle)
        case "${REPARO_REPORT_OUTCOME:-}" in succeeded|failed|unchanged|preview|blocked|unknown) ;; *) die 'Report utility requires a bounded lifecycle outcome' ;; esac
        report_native_result lifecycle_result native-installer "$REPARO_REPORT_OUTCOME" "${REPARO_REPORT_PREVIOUS_VERSION:-}"
        exit 0 ;;
    install)
        reporting_previous_version=$(sed -n "s/^REPARO_LINUX_VERSION='\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)'$/\1/p" "$DATA_ROOT/reparo-linux" 2>/dev/null || true)
        trap native_install_finalization EXIT
        run_native_installer; exit $? ;;
    task) configure_persistent_task; exit $? ;;
    status) show_status; exit 0 ;;
    kill) kill_reparo_processes; exit 0 ;;
    tail) tail_log; exit 0 ;;
esac

ensure_log_root
NOT_UPDATED_FILE="$LOG_ROOT/reparo_${RUN_ID}_not-updated.tmp"
: >"$NOT_UPDATED_FILE" || die "Cannot create not-updated report state: $NOT_UPDATED_FILE"
log "Reparo Linux $REPARO_LINUX_VERSION starting"
log "Mode: update force=$FORCE preview=$PREVIEW include=${INCLUDE:-auto} native=$(detect_native_section)"
syslog_event notice run_start -- running "native_$(detect_native_section)"
run_native_manager
run_optional Flatpak flatpak flatpak update -y
if section_selected Snap && command_exists snap; then run_privileged Snap 'snap refresh' snap refresh || true; fi
if section_selected Fwupd && command_exists fwupdmgr; then
    run_privileged Fwupd 'fwupdmgr refresh --force' fwupdmgr refresh --force || true
    run_privileged Fwupd 'fwupdmgr update --assume-yes' fwupdmgr update --assume-yes || true
fi
run_npm_global_update
run_opencode_update
run_optional Pipx pipx pipx upgrade-all
run_optional Pnpm pnpm pnpm update -g
run_optional Yarn yarn yarn global upgrade
run_optional DotNet dotnet dotnet tool update --global --all
run_optional Rust rustup rustup update
run_optional Conda conda conda update -n base -c defaults conda -y
run_optional Gem gem gem update
run_optional Composer composer composer global update
print_not_updated_report
log "Reparo Linux complete. Log: $LOG_FILE"
if [ "$PREVIEW" -eq 1 ]; then final_state=preview; else final_state=$RUN_RESULT; fi
syslog_event notice run_complete -- "$final_state" "force_$FORCE"
final_log="${LOG_FILE%_RUNNING.log}_$( [ "$PREVIEW" -eq 1 ] && printf PREVIEW || printf COMPLETE ).log"
mv "$LOG_FILE" "$final_log"
printf '%s\n' "Final log: $final_log"
reporting_outcome=unknown
[ "$RUN_RESULT" != failed ] || reporting_outcome=failed
[ "$PREVIEW" -eq 0 ] || reporting_outcome=preview
report_native_result maintenance_summary '' "$reporting_outcome" ''

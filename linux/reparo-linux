run_command() {
    section=$1
    description=$2
    shift 2
    log "[CMD] $section: $description"
    syslog_event notice command_start "$section" running "$description"
    if [ "$PREVIEW" -eq 1 ]; then
        log "[DRY-RUN] $section: $description"
        record_not_updated SKIPPED "$section" 'preview only' 'Run without preview only when maintenance is authorized.'
        return 0
    fi
    COMMAND_INDEX=$((COMMAND_INDEX+1))
    output_file=$(mktemp "$RECEIPT_ROOT/$COMMAND_INDEX.stdout.XXXXXX") || {
        RUN_FAILED=1; EVIDENCE_HEALTH=degraded
        write_command_receipt unknown '' '' '' '' "$section" "$description" "$@"
        return 1
    }
    error_file=$(mktemp "$RECEIPT_ROOT/$COMMAND_INDEX.stderr.XXXXXX") || {
        RUN_FAILED=1; EVIDENCE_HEALTH=degraded
        write_command_receipt unknown '' '' "$output_file" '' "$section" "$description" "$@"
        return 1
    }
    COMMAND_STARTED_UTC=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    COMMAND_CREATED_TICKS=''; COMMAND_BOOT_ID=''
    write_command_receipt planned '' '' "$output_file" "$error_file" "$section" "$description" "$@"
    "$@" >"$output_file" 2>"$error_file" &
    command_pid=$!
    if [ -r "/proc/$command_pid/stat" ]; then COMMAND_CREATED_TICKS=$(awk '{print $22}' "/proc/$command_pid/stat" 2>/dev/null || true); fi
    if [ -r /proc/sys/kernel/random/boot_id ]; then COMMAND_BOOT_ID=$(cat /proc/sys/kernel/random/boot_id); fi
    write_command_receipt running '' "$command_pid" "$output_file" "$error_file" "$section" "$description" "$@"
    if wait "$command_pid"; then status=0; command_outcome=command-success
    else status=$?; command_outcome=failed; RUN_FAILED=1; RUN_RESULT=failed
    fi
    # Native exit is committed before log rendering; neither tee nor telemetry owns it.
    write_command_receipt "$command_outcome" "$status" "$command_pid" "$output_file" "$error_file" "$section" "$description" "$@"
    if ! tee -a "$LOG_FILE" <"$output_file"; then EVIDENCE_HEALTH=degraded; fi
    if ! tee -a "$LOG_FILE" <"$error_file" >&2; then EVIDENCE_HEALTH=degraded; fi
    if [ "$status" -eq 0 ]; then log "[DONE] $section"
    else log "[FAIL] $section exited $status"; record_not_updated FAILED "$section" "command exited $status" 'Inspect retained evidence before retrying.'
    fi
    syslog_event notice command_complete "$section" "$command_outcome" "exit_$status"
    return "$status"
}


run_privileged() {
    section=$1
    description=$2
    shift 2
    if [ "$PREVIEW" -eq 1 ]; then
        run_command "$section" "$description" "$@"
    elif [ "$(id -u)" -eq 0 ]; then
        run_command "$section" "$description" "$@"
    elif command_exists sudo && sudo -n -l -- "$@" >/dev/null 2>&1; then
        run_command "$section" "$description" sudo -n "$@"
    else
        log "[SKIP] $section: root or passwordless sudo is required; refusing to prompt"
        syslog_event warning command_skipped "$section" skipped 'privilege_required'
        record_not_updated SKIPPED "$section" 'root or passwordless sudo is required' 'Review available authority for the selected command; Reparo does not change sudo policy.'
        return 0
    fi
}

run_optional() {
    section=$1
    executable=$2
    shift 2
    if ! section_selected "$section"; then return 0; fi
    if ! command_exists "$executable"; then
        log "[SKIP] $section: $executable not found"
        syslog_event notice command_skipped "$section" skipped 'tool_not_found'
        record_not_updated SKIPPED "$section" "$executable not found" 'Install or repair this tool only if you expect Reparo to manage it.'
        return 0
    fi
    run_command "$section" "$*" "$@" || true
}

npm_system_scope() {
    npm_root=$("$npm_executable" root -g 2>/dev/null || true)
    npm_prefix=$("$npm_executable" config get prefix 2>/dev/null || true)
    case "$npm_root" in
        /usr/*|/opt/*) return 0 ;;
    esac
    case "$npm_prefix" in
        /usr|/usr/*|/opt|/opt/*) return 0 ;;
    esac
    [ -n "$npm_root" ] && [ -e "$npm_root" ] && [ ! -w "$npm_root" ]
}

run_npm_global_update() {
    section_selected Npm || return 0
    if ! command_exists npm; then
        log '[SKIP] Npm: npm not found'
        syslog_event notice command_skipped Npm skipped tool_not_found
        record_not_updated SKIPPED Npm 'npm not found' 'Install or repair npm only if you expect Reparo to manage it.'
        return 0
    fi
    npm_executable=$(command -v npm)
    if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_UID:-}" ] && [ "$SUDO_UID" -ne 0 ]; then
        record_not_updated SKIPPED Npm 'ownership ambiguous: elevated invocation retains another user context' 'Run the owning user lane separately; no prefix or HOME migration is performed.'
        return 0
    fi

    # Preview is a strict non-executing mode: do not even query npm configuration.
    if [ "$PREVIEW" -eq 1 ]; then
        run_command Npm 'npm update -g (excluding opencode-ai and @opencode/cli; dedicated Opencode section)' "$npm_executable" update -g || true
        return 0
    fi

    # A broad npm update would bypass OpenCode ownership/process safeguards.
    npm_inventory=$(mktemp "${TMPDIR:-/tmp}/reparo-npm-inventory.XXXXXX") || return 1
    if ! "$npm_executable" ls -g --depth=0 --parseable >"$npm_inventory"; then
        rm -f "$npm_inventory"
        RUN_RESULT=failed; RUN_FAILED=1
        record_not_updated FAILED Npm 'cannot enumerate global npm packages' 'Repair npm ls -g --depth=0 before retrying; no broad update was attempted.'
        return 0
    fi
    set --
    npm_first_line=1
    while IFS= read -r npm_package_path; do
        if [ "$npm_first_line" -eq 1 ]; then npm_first_line=0; continue; fi
        [ -n "$npm_package_path" ] || continue
        npm_package_name=$(basename "$npm_package_path")
        npm_package_parent=$(basename "$(dirname "$npm_package_path")")
        case "$npm_package_parent" in @*) npm_package_name="$npm_package_parent/$npm_package_name" ;; esac
        case "$npm_package_name" in
            opencode-ai|@opencode/cli)
                log "[SKIP] Npm: $npm_package_name is handled by the dedicated Opencode section"
                ;;
            *) set -- "$@" "$npm_package_name" ;;
        esac
    done <"$npm_inventory"
    rm -f "$npm_inventory"
    if [ "$#" -eq 0 ]; then
        log '[SKIP] Npm: no global packages outside the dedicated Opencode section'
        return 0
    fi
    if ! command_exists python3; then
        record_not_updated SKIPPED Npm 'ownership visibility unavailable without python3' 'Inspect the owning prefix and active consumers before retrying.'
        return 0
    fi
    npm_owner_clear=0
    python3 - "$HOME" "$npm_executable" "$@" <<'PY' || npm_owner_clear=$?
import os,pathlib,subprocess,sys
home,npm,*packages=sys.argv[1:]
try:
    if os.stat(home).st_uid!=os.getuid(): raise ValueError('HOME owner mismatch')
    root=subprocess.check_output([npm,'root','-g'],text=True).strip()
    if not root or not os.path.isabs(root): raise ValueError('npm root unavailable')
    trees=[os.path.realpath(os.path.join(root,p)) for p in packages]
    if not pathlib.Path('/proc').is_dir(): raise ValueError('process visibility unavailable')
    for proc in pathlib.Path('/proc').iterdir():
        if not proc.name.isdigit(): continue
        try: command=(proc/'cmdline').read_bytes().replace(b'\0',b' ').decode(errors='replace')
        except FileNotFoundError: continue
        except PermissionError: raise ValueError('process ownership inaccessible')
        if any(tree in command for tree in trees): raise ValueError('active consumer in owning package tree')
except Exception as e:
    print('Npm ownership/consumer check blocked: '+str(e),file=sys.stderr);sys.exit(1)
PY
    if [ "$npm_owner_clear" -ne 0 ]; then
        record_not_updated SKIPPED Npm 'ownership or active-consumer visibility blocked mutation' 'Leave active sessions/services running; inspect the owning prefix.'
        return 0
    fi
    if npm_system_scope; then
        log '[INFO] Npm: detected system global prefix; using root or passwordless sudo'
        syslog_event notice npm_scope Npm detected system_global
        run_privileged Npm 'npm update -g (system global prefix, excluding OpenCode)' "$npm_executable" update -g -- "$@" || true
    else
        run_command Npm 'npm update -g (excluding OpenCode)' "$npm_executable" update -g -- "$@" || true
    fi
}

run_opencode_update() {
    section_selected Opencode || return 0
    if ! command_exists opencode; then
        log '[SKIP] Opencode: opencode not found'
        syslog_event notice command_skipped Opencode skipped tool_not_found
        record_not_updated SKIPPED Opencode 'opencode not found' 'Install OpenCode only if you expect Reparo to update it.'
        return 0
    fi
    if ! command_exists npm; then
        log '[SKIP] Opencode: npm not found; cannot update npm-managed installation'
        syslog_event notice command_skipped Opencode skipped npm_not_found
        record_not_updated SKIPPED Opencode 'npm not found for an npm-managed installation' 'Install or repair npm, then rerun the Opencode section.'
        return 0
    fi

    opencode_path=$(command -v opencode)
    opencode_prefix=$(dirname "$(dirname "$opencode_path")")
    opencode_target=$(readlink -f "$opencode_path" 2>/dev/null || true)
    opencode_package=''
    for opencode_candidate in @opencode/cli opencode-ai; do
        case "$opencode_target" in
            "$opencode_prefix/lib/node_modules/$opencode_candidate/"*)
                if [ -f "$opencode_prefix/lib/node_modules/$opencode_candidate/package.json" ]; then
                    opencode_package=$opencode_candidate
                    break
                fi
                ;;
        esac
    done
    if [ -z "$opencode_package" ]; then
        log "[SKIP] Opencode: $opencode_path is not a standard npm global installation"
        syslog_event notice command_skipped Opencode skipped unsupported_installation
        record_not_updated SKIPPED Opencode 'active command is not a standard npm global installation' 'Update OpenCode through the installer or package manager that owns the active command.'
        return 0
    fi

    # Do not stop a service or client to replace its executable. pgrep checks all
    # users conservatively; unknown process state is not permission to update.
    if ! command_exists pgrep; then
        record_not_updated SKIPPED Opencode 'pgrep unavailable; cannot check running OpenCode' 'Install procps, then retry with OpenCode stopped.'
        return 0
    fi
    opencode_process_status=0
    pgrep -x 'opencode|opencode2' >/dev/null 2>&1 || opencode_process_status=$?
    if [ "$opencode_process_status" -ne 1 ]; then
        log '[SKIP] Opencode: OpenCode is running or process state is unknown; no sessions will be terminated'
        record_not_updated SKIPPED Opencode 'OpenCode running or process state unknown' 'Close clients and stop the OpenCode service, then rerun; Reparo never terminates sessions.'
        return 0
    fi

    npm_executable=$(command -v npm)
    if [ "$opencode_package" = opencode-ai ]; then
        if [ -f "$opencode_prefix/lib/node_modules/@opencode/cli/package.json" ]; then
            log '[SKIP] Opencode: V1 owns the command but V2 is also installed; resolve the mixed installation before migrating'
            record_not_updated SKIPPED Opencode 'mixed V1/V2 installation with V1 active' 'Remove the conflicting installation through its owning package manager, then rerun.'
            return 0
        fi
        opencode_legacy_version=$(node -e 'const v = require(process.argv[1]).version; if (!/^\d+\.\d+\.\d+([-+][0-9A-Za-z.-]+)?$/.test(v)) process.exit(1); console.log(v)' "$opencode_prefix/lib/node_modules/opencode-ai/package.json" 2>/dev/null || true)
        case "$opencode_legacy_version" in
            ''|*[!0-9A-Za-z.+-]*)
                record_not_updated FAILED Opencode 'cannot read installed V1 version for rollback' 'Repair the package manifest and node installation before migrating.'
                RUN_RESULT=failed; RUN_FAILED=1
                return 0 ;;
        esac
        opencode_migration_script='
npm=$1; prefix=$2; old_version=$3
"$npm" uninstall --global --prefix "$prefix" opencode-ai
status=$?
if [ "$status" -eq 0 ]; then
    "$npm" install --global --prefix "$prefix" @opencode/cli@latest --allow-scripts=@opencode/cli --ignore-scripts=false
    status=$?
    if [ "$status" -eq 0 ]; then "$prefix/bin/opencode" --version; status=$?; fi
fi
if [ "$status" -ne 0 ]; then
    printf "%s\n" "[ROLLBACK] OpenCode V2 migration failed; attempting to restore opencode-ai $old_version"
    "$npm" uninstall --global --prefix "$prefix" @opencode/cli
    if "$npm" install --global --prefix "$prefix" "opencode-ai@$old_version" --allow-scripts=opencode-ai --ignore-scripts=false; then
        printf "%s\n" "[ROLLBACK] Restored opencode-ai $old_version"
    else
        printf "%s\n" "[FAIL] V1 rollback also failed; repair this npm prefix manually" >&2
    fi
fi
exit "$status"
'
        case "$opencode_prefix" in
            /usr|/usr/*|/opt|/opt/*)
                run_privileged Opencode 'migrate npm-owned OpenCode V1 to V2 (owning prefix; rollback on failure)' sh -c "$opencode_migration_script" reparo "$npm_executable" "$opencode_prefix" "$opencode_legacy_version" || true ;;
            *)
                run_command Opencode 'migrate npm-owned OpenCode V1 to V2 (owning prefix; rollback on failure)' sh -c "$opencode_migration_script" reparo "$npm_executable" "$opencode_prefix" "$opencode_legacy_version" || true ;;
        esac
        return 0
    fi
    # Do not invoke `opencode upgrade`: it prompts before modifying an npm-owned
    # executable, and its npm method follows npm's configured prefix rather than the
    # prefix that owns the active OpenCode command. Update that owning prefix directly.
    opencode_update_script='
"$1" install --global --prefix "$2" "$3@latest" "--allow-scripts=$3" --ignore-scripts=false && "$2/bin/opencode" --version
'
    case "$opencode_prefix" in
        /usr|/usr/*|/opt|/opt/*)
            run_privileged Opencode "npm install --global $opencode_package@latest (owning prefix)" sh -c "$opencode_update_script" reparo "$npm_executable" "$opencode_prefix" "$opencode_package" || true
            ;;
        *)
            run_command Opencode "npm install --global $opencode_package@latest (owning prefix)" sh -c "$opencode_update_script" reparo "$npm_executable" "$opencode_prefix" "$opencode_package" || true
            ;;
    esac
}

run_native_manager() {
    native_section=$(detect_native_section)
    if ! section_selected "$native_section"; then return 0; fi
    case "$native_section" in
        Apt)
            command_exists apt-get || { log '[SKIP] Apt: apt-get not found'; syslog_event notice command_skipped Apt skipped tool_not_found; return; }
            if command_exists dpkg-query; then dpkg-query -W -f '${binary:Package}\t${Version}\n' >"$RECEIPT_ROOT/apt-before.tsv" || EVIDENCE_HEALTH=degraded; fi
            run_privileged Apt 'apt-get update' env DEBIAN_FRONTEND=noninteractive apt-get update || { if command_exists dpkg-query; then dpkg-query -W -f '${binary:Package}\t${Version}\n' >"$RECEIPT_ROOT/apt-after.tsv" || EVIDENCE_HEALTH=degraded; fi; return; }
            run_privileged Apt 'apt-get -y upgrade' env DEBIAN_FRONTEND=noninteractive apt-get -y upgrade || { if command_exists dpkg-query; then dpkg-query -W -f '${binary:Package}\t${Version}\n' >"$RECEIPT_ROOT/apt-after.tsv" || EVIDENCE_HEALTH=degraded; fi; return; }
            run_privileged Apt 'apt-get -y autoremove' env DEBIAN_FRONTEND=noninteractive apt-get -y autoremove || { if command_exists dpkg-query; then dpkg-query -W -f '${binary:Package}\t${Version}\n' >"$RECEIPT_ROOT/apt-after.tsv" || EVIDENCE_HEALTH=degraded; fi; return; }
            if command_exists dpkg-query; then dpkg-query -W -f '${binary:Package}\t${Version}\n' >"$RECEIPT_ROOT/apt-after.tsv" || EVIDENCE_HEALTH=degraded; fi
            ;;
        Dnf)
            command_exists dnf || { log '[SKIP] Dnf: dnf not found'; syslog_event notice command_skipped Dnf skipped tool_not_found; return; }
            run_privileged Dnf 'dnf -y upgrade' dnf -y upgrade || return
            run_privileged Dnf 'dnf -y autoremove' dnf -y autoremove || return
            ;;
        Pacman)
            command_exists pacman || { log '[SKIP] Pacman: pacman not found'; syslog_event notice command_skipped Pacman skipped tool_not_found; return; }
            run_privileged Pacman 'pacman -Syu --noconfirm' pacman -Syu --noconfirm || return
            ;;
        Zypper)
            command_exists zypper || { log '[SKIP] Zypper: zypper not found'; syslog_event notice command_skipped Zypper skipped tool_not_found; return; }
            run_privileged Zypper 'zypper --non-interactive refresh' zypper --non-interactive refresh || return
            run_privileged Zypper 'zypper --non-interactive update' zypper --non-interactive update || return
            ;;
        *) log '[SKIP] Native: no supported package manager detected'; syslog_event warning command_skipped Native skipped no_supported_manager; record_not_updated SKIPPED Native 'no supported package manager detected' 'Use the distribution package manager manually.' ;;
    esac
}

latest_log() {
    latest=''
    for candidate in "$LOG_ROOT"/reparo_*.log; do
        [ -f "$candidate" ] || continue
        case "$candidate" in *_COMPLETE.log|*_FAILED.log|*_PREVIEW.log) ;; *) continue ;; esac
        grep -q 'Reparo Linux .* starting' "$candidate" || continue
        if [ -z "$latest" ] || [ "$candidate" -nt "$latest" ]; then latest=$candidate; fi
    done
    printf '%s' "$latest"
}

list_reparo_processes() {
    grep -al 'reparo-linux' /proc/[0-9]*/cmdline 2>/dev/null | while IFS= read -r cmdline_path; do
        proc=${cmdline_path%/cmdline}
        pid=${proc#/proc/}
        process_is_current_tree "$pid" && continue
        cmdline=$({ tr '\000' ' ' <"$cmdline_path"; } 2>/dev/null || true)
        # The command line may merely mention Reparo (for example a shellcheck
        # invocation). The runtime script must be argv[1], as it is for both the
        # executable script and the installed sh shim.
        script_path=$({ tr '\000' '\n' <"$cmdline_path" | awk 'NR == 2 { print; exit }'; } 2>/dev/null || true)
        case "$script_path" in */reparo-linux|reparo-linux) printf '%s\t%s\n' "$pid" "$cmdline" ;; esac
    done
}

process_parent_id() {
    awk '/^PPid:/{print $2; exit}' "/proc/$1/status" 2>/dev/null
}

build_protected_processes() {
    PROTECTED_PROCESSES=" $$ "
    parent=$(process_parent_id "$$")
    while [ -n "$parent" ] && [ "$parent" -gt 1 ] 2>/dev/null; do
        PROTECTED_PROCESSES="${PROTECTED_PROCESSES}${parent} "
        parent=$(process_parent_id "$parent")
    done
}

process_is_current_tree() {
    candidate=$1
    case "$PROTECTED_PROCESSES" in *" $candidate "*) return 0 ;; esac
    while [ -n "$candidate" ] && [ "$candidate" -gt 1 ] 2>/dev/null; do
        [ "$candidate" = "$$" ] && return 0
        candidate=$(process_parent_id "$candidate")
    done
    return 1
}

show_status() {
    ensure_log_root
    log "Reparo Linux $REPARO_LINUX_VERSION status"
    syslog_event notice status -- success requested
    log "Log root: $LOG_ROOT"
    processes=$(list_reparo_processes)
    if [ -n "$processes" ]; then
        log 'Running Reparo Linux processes:'
        printf '%s\n' "$processes" | tee -a "$LOG_FILE"
    else
        log 'Running: none'
    fi
    latest=$(latest_log)
    if [ -n "$latest" ]; then log "Latest log: $latest"; else log 'Latest log: none'; fi
    if command_exists python3; then
        python3 - "$LOG_ROOT" <<'PY'
import datetime,json,pathlib,sys
views=[]
for path in pathlib.Path(sys.argv[1]).glob('reparo_*_repair.json'):
    try:
        view=json.loads(path.read_text(encoding='utf-8'))
        if view['schema']=='reparo-repair/1' and view['parent']['execution_finished']: views.append((view['as_of'],path,view))
    except (OSError,ValueError,KeyError,TypeError): pass
if views:
    _,path,view=max(views,key=lambda row:row[0]);c=view['counts']
    print(f"REPARO - SAVED MAINTENANCE VIEW | changed {c['confirmed_changes']} | failed {c['failed']} | blocked {c['blocked']} | pending/unknown {c['pending_unknown']} | evidence gaps {c['evidence_gaps']}")
    print(f"REPARO-REPAIR-HANDOFF/1 | {view['host']} / {view['run_id']} / Reparo {view['source']['version']}")
    for item in view['attention'][:2]: print(f"{item['id']} {item['backend']}: {item['outcome']}; {' '.join(item['reason'].split())[:180]}; cause unknown")
    if not view['attention']: print('No repair actions identified in this captured run.')
    if len(view['attention'])>2: print(f"+{len(view['attention'])-2} groups in complete repair file")
    print(f"Evidence/repair: {path} | read-only as-of {datetime.datetime.now(datetime.timezone.utc).isoformat()}")
PY
    fi
}

kill_reparo_processes() {
    ensure_log_root
    syslog_event notice kill -- requested requested
    processes=$(list_reparo_processes)
    if [ -z "$processes" ]; then
        log 'No other Reparo Linux process found.'
        syslog_event notice kill -- success none_found
        return 0
    fi
    printf '%s\n' "$processes" | while IFS="$(printf '\t')" read -r pid cmdline; do
        log "[KILL] SIGTERM PID $pid: $cmdline"
        if kill -TERM "$pid" 2>/dev/null; then log "[DONE] stopped PID $pid"; syslog_event warning kill Reparo success "pid_$pid"; else log "[FAIL] could not stop PID $pid"; syslog_event err kill Reparo failed "pid_$pid"; fi
    done
}

tail_log() {
    mkdir -p "$LOG_ROOT" || die "Cannot create log directory: $LOG_ROOT"
    latest=$(latest_log)
    [ -n "$latest" ] || die "No Reparo Linux log found in $LOG_ROOT"
    printf '%s\n' "Following $latest"
    tail -n "$TAIL_LINES" -f "$latest"
}

parse_args() {
    while [ "$#" -gt 0 ]; do
        original_option=$1
        option=$(normalize_option "$original_option")
        if [ "$ACTION" = task ]; then
            case "$option" in new|n|install|i|latest|report-lifecycle|status|s|kill|k|tail|t|log|version|v|help|h) die 'Task cannot schedule lifecycle or utility modes' ;; esac
        fi
        case "$option" in
            update|u) ;;
            force|f) FORCE=1 ;;
            preview|p) PREVIEW=1 ;;
            status|s) ACTION=status ;;
            kill|k) ACTION=kill ;;
            tail|t|log) ACTION=tail ;;
            version|v) ACTION=version ;;
            new|n|install|i) ACTION=install ;;
            latest) ACTION=install; LATEST=1 ;;
            report-lifecycle) ACTION=report-lifecycle ;;
            task)
                [ "$ACTION" = update ] || die 'Task cannot be combined with lifecycle/utility actions'
                ACTION=task ;;
            task-name|taskname) shift; [ "$#" -gt 0 ] || die '--task-name needs a name'; TASK_NAME=$1; TASK_CONTROLS=1 ;;
            task-action|taskaction) shift; [ "$#" -gt 0 ] || die '--task-action needs an action'; TASK_ACTION=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]'); TASK_CONTROLS=1 ;;
            task-replace|taskreplace) TASK_REPLACE=1; TASK_CONTROLS=1 ;;
            help|h) ACTION=help ;;
            tail-lines|taillines|tl)
                shift; [ "$#" -gt 0 ] || die '--tail-lines needs a positive number'
                TAIL_LINES=$1 ;;
            include|c)
                shift
                [ "$#" -gt 0 ] || die '--include needs at least one section'
                while [ "$#" -gt 0 ]; do
                    case "$1" in -*) break ;; *) add_include "$1"; shift ;; esac
                done
                continue ;;
            *)
                if [ "$ACTION" = task ]; then
                    case "$original_option" in -*) die "Unsupported scheduling option: $original_option" ;; esac
                    TASK_TEXT="${TASK_TEXT}${TASK_TEXT:+ }$original_option"; shift; continue
                fi
                if windows_only_option "$option"; then
                    die "$original_option is currently Windows-only; Linux does not pretend otherwise"
                fi
                die "Unknown option: $original_option"
                ;;
        esac
        shift
    done
    case "$TAIL_LINES" in ''|*[!0-9]*) die '--tail-lines must be a positive integer' ;; esac
    [ "$TAIL_LINES" -gt 0 ] || die '--tail-lines must be greater than zero'
    [ "$TASK_CONTROLS" -eq 0 ] || [ "$ACTION" = task ] || die 'Task controls require --task; refusing accidental maintenance'
}

ACTION=update
TASK_TEXT=''
TASK_NAME=default
TASK_ACTION=create
TASK_REPLACE=0
TASK_CONTROLS=0
parse_args "$@"
[ "$ACTION" != report-lifecycle ] || [ "$#" -eq 1 ] || die 'Report utility cannot run other operations'
build_protected_processes
case "$ACTION" in

* text=auto

# Authenticode signatures cover exact bytes. Never normalize PowerShell scripts
# in Git or GitHub's raw endpoint will invalidate their signatures.
*.ps1 -text
*.bat text eol=crlf
*.cmd text eol=crlf

# Documentation and repo metadata stay LF for cleaner diffs.
*.sh text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
